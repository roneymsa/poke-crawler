{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Debug Poké-Crawler (main.py)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--list",
        "${workspaceFolder}/pokemon_names.txt"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    }
  ]
}
